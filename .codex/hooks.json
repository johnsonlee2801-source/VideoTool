{
  "description": "VideoTool source-bound TDD commit/push guard. Review and trust through native Codex /hooks.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git --no-optional-locks rev-parse --show-toplevel)/tools/tdd-guardian/local/pretool.js\"",
            "timeout": 60,
            "statusMessage": "Checking VideoTool TDD gates"
          }
        ]
      }
    ]
  }
}
