<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime (Developer ID): libmpv embeds LuaJIT, whose JIT compiler
	     needs to map executable memory. Unverified until the first notarized build. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
</dict>
</plist>
